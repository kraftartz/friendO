<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and below. Read through android:fullBackupContent.

  An empty <full-backup-content> excludes nothing, so every rule here is
  explicit. Each <exclude> names one of the four places this app writes to.
  The Profile list is the reason: it holds a display name, an Avatar and a PIN
  hash, and it is the one file that no key covers.

  See ADR-0020.
-->
<full-backup-content>
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="file" />
    <exclude domain="external" />
    <exclude domain="root" />
</full-backup-content>
