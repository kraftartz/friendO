<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and above. Read through android:dataExtractionRules.

  Two transports, two rule sets, and both must exclude everything:
  <cloud-backup> covers Google Drive, <device-transfer> covers a phone-to-phone
  copy. A rule set that lists no <exclude> backs the app up in full, so silence
  here is the wrong default.

  See ADR-0020.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
